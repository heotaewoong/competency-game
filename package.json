{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit -p tsconfig.quality.json",
    "quality": "npm run typecheck && npm run lint && npm test && npm run test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test": "npm run test:rotation && npm run test:nback && npm run test:rps && npm run test:appointment && npm run test:path && npm run test:potion && npm run test:number && npm run test:count && npm run test:mouse && npm run test:feedback && npm run test:guides && npm run test:review && npm run test:storage && npm run test:timers && npm run test:glyphs && npm run test:practice-config && npm run test:comparison && npm run test:recommendation && npm run test:display && npm run test:readiness && npm run test:onboarding && npm run test:backup && npm run test:envelope",
    "test:rps": "node --test --experimental-strip-types app/lib/rps-game.test.ts",
    "test:mouse": "node --test --experimental-strip-types app/lib/mouse-game.test.ts",
    "test:count": "node --test --experimental-strip-types app/lib/count-game.test.ts",
    "test:appointment": "node --test --experimental-strip-types app/lib/appointment-game.test.ts",
    "test:path": "node --test --experimental-strip-types app/lib/path-game.test.ts",
    "test:potion": "node --test --experimental-strip-types app/lib/potion-game.test.ts",
    "test:number": "node --test --experimental-strip-types app/lib/number-game.test.ts",
    "test:feedback": "node --test --experimental-strip-types app/lib/feedback.test.ts",
    "test:rotation": "node --test --experimental-strip-types app/lib/rotation-game.test.ts",
    "test:nback": "node --test --experimental-strip-types app/lib/nback-game.test.ts",
    "test:guides": "node --test --experimental-strip-types app/lib/strategy-guide.test.ts",
    "test:review": "node --test --experimental-strip-types app/lib/review-data.test.ts",
    "test:storage": "node --test --experimental-strip-types app/lib/result-storage.test.ts",
    "test:timers": "node --test --experimental-strip-types app/lib/pausable-timer.test.ts",
    "test:glyphs": "node --test --experimental-strip-types app/lib/glyph-mnemonics.test.ts",
    "test:practice-config": "node --test --experimental-strip-types app/lib/practice-config-storage.test.ts",
    "test:comparison": "node --test --experimental-strip-types app/lib/result-comparison.test.ts",
    "test:recommendation": "node --test --experimental-strip-types app/lib/training-recommendation.test.ts",
    "test:display": "node --test --experimental-strip-types app/lib/result-display.test.ts",
    "test:readiness": "node --test --experimental-strip-types app/lib/readiness.test.ts",
    "test:onboarding": "node --test --experimental-strip-types app/lib/game-onboarding.test.ts",
    "test:backup": "node --test --experimental-strip-types app/lib/practice-backup.test.ts",
    "test:envelope": "node --test --experimental-strip-types app/lib/result-envelope.test.ts"
  },
  "dependencies": {
    "next": "^16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.2",
    "@cloudflare/workers-types": "5.20260831.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.3",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "^1.0.0-beta.8",
    "vite": "8.2.2",
    "wrangler": "4.127.1"
  },
  "type": "module"
}
